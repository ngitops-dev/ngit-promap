[app]
ENV = "development"
FASTAPI_BASE_URL = "http://localhost:8000"

[google]
# Paste the full JSON content of gmail-token.json (generated by tests/test_gmail_auth.py)
oauth_token_json = ""
# OR paste the full JSON content of your service account file
service_account_json = ""
# Your Google Sheet ID
sheet_id = ""
# Gmail sender address (must match the OAuth-authorized email)
sender = ""
